# Chave da API oficial do Google AI Studio (Gemini).
# Obtenha a sua em https://aistudio.google.com/apikey
# Esta chave NUNCA deve ser exposta ao frontend.
GEMINI_API_KEY=coloque_sua_chave_aqui

# Porta em que o backend será executado.
PORT=3001

# Origem permitida para requisições CORS (URL do frontend).
# Em desenvolvimento, o Vite normalmente roda em http://localhost:5173
CORS_ORIGIN=http://localhost:5173

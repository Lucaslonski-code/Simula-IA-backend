{
  "name": "simula-ia-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Backend do Simula-IA: recebe conteúdo do usuário, extrai texto, gera o simulado via Gemini e corrige as respostas.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
